[Unit]
Description=Fortify Lab Manager Telegram SDLC supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/fortify-supervisor telegram-loop
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/fortify-lab-manager

[Install]
WantedBy=default.target
