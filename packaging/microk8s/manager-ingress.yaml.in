apiVersion: v1
kind: Service
metadata:
  name: fortify-manager-host
  namespace: fortify
spec:
  ports:
    - name: http
      port: @BACKEND_PORT@
      targetPort: @BACKEND_PORT@
---
apiVersion: v1
kind: Endpoints
metadata:
  name: fortify-manager-host
  namespace: fortify
subsets:
  - addresses:
      - ip: @BACKEND_ADDRESS@
    ports:
      - name: http
        port: @BACKEND_PORT@
        protocol: TCP
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: fortify-manager
  namespace: fortify
  annotations:
    nginx.ingress.kubernetes.io/proxy-connect-timeout: "5"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "30"
spec:
  ingressClassName: public
  tls:
    - hosts:
        - lab.@DOMAIN@
      secretName: @TLS_SECRET@
  rules:
    - host: lab.@DOMAIN@
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: fortify-manager-host
                port:
                  number: @BACKEND_PORT@
