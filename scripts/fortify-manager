#!/usr/bin/env bash

set -euo pipefail

REPOSITORY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="$(<"$REPOSITORY_ROOT/VERSION")"
CONFIG_ROOT="${FORTIFY_MANAGER_CONFIG_ROOT:-/etc/fortify-lab-manager}"
STATE_ROOT="${FORTIFY_MANAGER_STATE_ROOT:-/var/lib/fortify-lab-manager}"
INSTALL_ROOT="${FORTIFY_MANAGER_INSTALL_ROOT:-/opt/fortify-lab-manager}"
UNIT_PATH="${FORTIFY_MANAGER_UNIT_PATH:-/etc/systemd/system/fortify-manager.service}"
PROBE_UNIT_PATH="${FORTIFY_MANAGER_PROBE_UNIT_PATH:-/etc/systemd/system/fortify-health-probe.service}"
HELM_EVIDENCE_SERVICE_PATH="${FORTIFY_MANAGER_HELM_EVIDENCE_SERVICE_PATH:-/etc/systemd/system/fortify-helm-release-evidence.service}"
HELM_EVIDENCE_TIMER_PATH="${FORTIFY_MANAGER_HELM_EVIDENCE_TIMER_PATH:-/etc/systemd/system/fortify-helm-release-evidence.timer}"
CLI_PATH="${FORTIFY_MANAGER_CLI_PATH:-/usr/local/bin/fortify-manager-cli}"
MANIFEST_PATH="${FORTIFY_MANAGER_MANIFEST_PATH:-/var/lib/fortify-lab-manager/manager-ingress.yaml}"
CLUSTER_ACCESS_ROOT="${FORTIFY_MANAGER_CLUSTER_ACCESS_ROOT:-$STATE_ROOT/cluster-access}"
APISERVER_ARGS="${FORTIFY_MANAGER_APISERVER_ARGS:-/var/snap/microk8s/current/args/kube-apiserver}"
PACKAGE_VALIDATOR="${FORTIFY_MANAGER_PACKAGE_VALIDATOR:-$REPOSITORY_ROOT/scripts/package-manager-runtime.py}"
LIFECYCLE_KUBECONFIG="$CLUSTER_ACCESS_ROOT/lifecycle.kubeconfig"
LIFECYCLE_CLIENT_ROOT="${FORTIFY_MANAGER_LIFECYCLE_CLIENT_ROOT:-$STATE_ROOT/lifecycle-bin}"
KUBECTL_CLIENT="${FORTIFY_MANAGER_KUBECTL_CLIENT:-/snap/microk8s/current/kubectl}"
HELM_CLIENT="${FORTIFY_MANAGER_HELM_CLIENT:-/snap/microk8s/current/bin/helm}"
KUBERNETES_SERVER="${FORTIFY_MANAGER_KUBERNETES_SERVER:-https://127.0.0.1:16443}"
TLS_SECRET="${FORTIFY_MANAGER_TLS_SECRET:-tls}"
SERVICE_NAME="fortify-manager.service"
PROBE_SERVICE_NAME="fortify-health-probe.service"
CONFIG_BACKUP_ROOT="${FORTIFY_MANAGER_CONFIG_BACKUP_ROOT:-$STATE_ROOT/config-backups}"

usage() {
    cat <<'EOF'
Usage: sudo ./scripts/fortify-manager COMMAND [arguments]

Commands:
  install                         Install/upgrade files and safely migrate protected config
  config-inspect                  Report schema and protected capability metadata
  config-migrate                  Back up, validate, and atomically migrate manager.toml
  config-rollback BACKUP          Validate and atomically restore a protected backup
  config-diagnose                 Run sanitized configuration diagnostics
  rbac-preflight                  Report desired/effective MicroK8s RBAC state
  install-cluster-access [--approve-enable-rbac] [--approve-restart]
                                  Verify RBAC and activate protected observer access
  activate-lifecycle              Verify and activate bounded lifecycle execution
  deactivate-lifecycle            Revoke lifecycle mutation; preserve all lab data
  refresh-release-evidence        Publish a sanitized protected Helm history snapshot
  bootstrap-account [USERNAME]    Prompt for and persist the first/local account verifier
  configure DOMAIN PRIVATE_ADDRESS [PORT] [PUBLIC_ADDRESS]
                                  Configure private ingress and public DNS expectation
  render-ingress DOMAIN PRIVATE_ADDRESS [PORT] [OUTPUT]
                                  Render only; does not contact MicroK8s
  start | stop | restart | status Manage the host service
  probe-status | probe-diagnose | probe-restart | probe-disable
                                  Operate the protected functional-health probe
  upgrade                         Back up manager state, install, and restart
  diagnose                        Run sanitized service and ingress checks
  uninstall                       Remove service and ingress; preserve config/state
  delete-state                    Separately delete manager state after typed confirmation
EOF
}

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

require_root() {
    [ "$(id -u)" -eq 0 ] || fail "run this command with sudo"
}

manager_config() {
    local command="$1"
    shift
    PYTHONPATH="$REPOSITORY_ROOT" python3 -m manager.config_migration "$command" "$@" \
        --config "$CONFIG_ROOT/manager.toml" \
        --backup-root "$CONFIG_BACKUP_ROOT" \
        --access-root "$CLUSTER_ACCESS_ROOT"
}

validate_domain() {
    [[ "$1" =~ ^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$ ]] ||
        fail "domain must be a DNS name"
}

validate_address() {
    python3 - "$1" <<'PY' || exit 1
import ipaddress
import sys
try:
    address = ipaddress.ip_address(sys.argv[1])
    if not address.is_private:
        raise ValueError
except ValueError:
    print("ERROR: backend address must be a private IP address", file=sys.stderr)
    raise SystemExit(1)
PY
}

validate_public_address() {
    python3 - "$1" "$2" <<'PY' || exit 1
import ipaddress
import sys
try:
    address = ipaddress.ip_address(sys.argv[1])
    private_address = ipaddress.ip_address(sys.argv[2])
    legacy_private_only = address == private_address and private_address.is_private
    if not legacy_private_only and (address.version != 4 or not address.is_global):
        raise ValueError
except ValueError:
    print(
        "ERROR: explicit public address must be a public IPv4 address",
        file=sys.stderr,
    )
    raise SystemExit(1)
PY
}

configured_public_address() {
    local fallback="$1"
    PYTHONPATH="$REPOSITORY_ROOT" python3 - \
        "$CONFIG_ROOT/manager.toml" "$fallback" <<'PY'
import ipaddress
import sys
import tomllib

try:
    with open(sys.argv[1], "rb") as stream:
        document = tomllib.load(stream)
    value = document.get("network", {}).get("public_address", sys.argv[2])
    if not isinstance(value, str):
        raise ValueError
    ipaddress.ip_address(value)
except (OSError, ValueError, tomllib.TOMLDecodeError):
    raise SystemExit(1)
print(value)
PY
}

write_network_config() {
    local source="$1" target="$2" domain="$3" private_address="$4" public_address="$5"
    python3 - "$source" "$target" "$domain" "$private_address" "$public_address" <<'PY'
import re
import sys
from pathlib import Path

source, target, domain, private_address, public_address = sys.argv[1:]
lines = Path(source).read_text(encoding="utf-8").splitlines(keepends=True)
result = []
in_network = False
for line in lines:
    section = re.match(r"^\s*\[([^]]+)]\s*(?:#.*)?$", line)
    if section:
        in_network = section.group(1) == "network"
    if in_network and re.match(
        r"^\s*(domain|private_backend_address|public_address)\s*=", line
    ):
        continue
    result.append(line)
if result and not result[-1].endswith("\n"):
    result[-1] += "\n"
if not any(re.match(r"^\s*\[network]\s*(?:#.*)?$", line) for line in result):
    if result and result[-1].strip():
        result.append("\n")
    result.append("[network]\n")
    insert_at = len(result)
else:
    start = next(i for i, line in enumerate(result) if re.match(r"^\s*\[network]", line))
    insert_at = next(
        (i for i in range(start + 1, len(result)) if re.match(r"^\s*\[", result[i])),
        len(result),
    )
values = (
    f'domain = "{domain}"\n',
    f'private_backend_address = "{private_address}"\n',
    f'public_address = "{public_address}"\n',
)
result[insert_at:insert_at] = values
Path(target).write_text("".join(result), encoding="utf-8")
PY
}

validate_port() {
    [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ] ||
        fail "backend port must be from 1 through 65535"
}

validate_resource_name() {
    [[ "$1" =~ ^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ ]] ||
        fail "TLS Secret must be a Kubernetes resource name"
}

render_ingress() {
    local domain="$1" address="$2" port="${3:-8080}" output="${4:-$MANIFEST_PATH}" template address_type
    validate_domain "$domain"
    validate_address "$address"
    validate_port "$port"
    validate_resource_name "$TLS_SECRET"
    address_type="$(python3 -c 'import ipaddress,sys; print("IPv4" if ipaddress.ip_address(sys.argv[1]).version == 4 else "IPv6")' "$address")"
    install -d -m 700 "$(dirname "$output")"
    case "${FORTIFY_MANAGER_ENDPOINT_API:-endpointslice}" in
        endpointslice) template="$REPOSITORY_ROOT/packaging/microk8s/manager-ingress.yaml.in" ;;
        legacy) template="$REPOSITORY_ROOT/packaging/microk8s/manager-ingress-legacy-endpoints.yaml.in" ;;
        *) fail "endpoint API must be endpointslice or legacy" ;;
    esac
    sed -e "s/@DOMAIN@/$domain/g" \
        -e "s/@BACKEND_ADDRESS@/$address/g" \
        -e "s/@ADDRESS_TYPE@/$address_type/g" \
        -e "s/@BACKEND_PORT@/$port/g" \
        -e "s/@TLS_SECRET@/$TLS_SECRET/g" \
        "$template" >"$output"
    chmod 600 "$output"
    printf 'Rendered manager ingress at %s\n' "$output"
}

remove_obsolete_backend() {
    case "$1" in
        endpointslice)
            microk8s kubectl -n fortify delete endpoints fortify-manager-host \
                --ignore-not-found >/dev/null ||
                fail "EndpointSlice is active, but the obsolete Endpoints backend could not be removed"
            ;;
        legacy)
            microk8s kubectl -n fortify delete endpointslice fortify-manager-host \
                --ignore-not-found >/dev/null ||
                fail "legacy Endpoints is active, but the obsolete EndpointSlice backend could not be removed"
            ;;
        *) fail "endpoint API must be endpointslice or legacy" ;;
    esac
}

configure_route() {
    require_root
    local domain="$1" address="$2" port="${3:-8080}" public_address="${4:-$2}" config_candidate port_candidate manifest_candidate endpoint_api endpoint_resources
    [ -f "$CONFIG_ROOT/manager.toml" ] ||
        fail "install the manager before configuring ingress"
    validate_domain "$domain"
    validate_address "$address"
    validate_port "$port"
    validate_public_address "$public_address" "$address"
    config_candidate="$(mktemp "$CONFIG_ROOT/.manager.toml.XXXXXX")"
    port_candidate="$(mktemp "$CONFIG_ROOT/.manager-port.toml.XXXXXX")"
    manifest_candidate="$(mktemp "$(dirname "$MANIFEST_PATH")/.manager-ingress.XXXXXX")"
    trap 'rm -f "$config_candidate" "$port_candidate" "$manifest_candidate"' RETURN
    sed "s/^port = [0-9][0-9]*$/port = $port/" \
        "$CONFIG_ROOT/manager.toml" >"$port_candidate"
    write_network_config "$port_candidate" "$config_candidate" \
        "$domain" "$address" "$public_address"
    rm -f "$port_candidate"
    grep -q "^port = $port$" "$config_candidate" ||
        fail "manager configuration has no server port"
    endpoint_resources="$(microk8s kubectl api-resources --api-group=discovery.k8s.io -o name 2>/dev/null)" ||
        fail "Kubernetes API discovery failed; existing configuration was preserved"
    if grep -qx endpointslices.discovery.k8s.io <<<"$endpoint_resources"; then
        endpoint_api=endpointslice
        FORTIFY_MANAGER_ENDPOINT_API="$endpoint_api" \
            render_ingress "$domain" "$address" "$port" "$manifest_candidate"
    else
        endpoint_api=legacy
        printf 'WARNING: EndpointSlice v1 is unavailable; using the documented legacy Endpoints compatibility path.\n' >&2
        FORTIFY_MANAGER_ENDPOINT_API="$endpoint_api" \
            render_ingress "$domain" "$address" "$port" "$manifest_candidate"
    fi
    microk8s kubectl apply --dry-run=server -f "$manifest_candidate" >/dev/null ||
        fail "manager ingress configuration was rejected; existing configuration was preserved"
    microk8s kubectl apply -f "$manifest_candidate" ||
        fail "manager ingress could not be applied; existing configuration was preserved"
    remove_obsolete_backend "$endpoint_api"
    chown root:fortify-manager "$config_candidate"
    chmod 640 "$config_candidate"
    mv -f "$config_candidate" "$CONFIG_ROOT/manager.toml"
    mv -f "$manifest_candidate" "$MANIFEST_PATH"
    trap - RETURN
    printf 'Configured manager route; restart the service to activate port %s.\n' "$port"
}

prepare_runtime_candidate() {
    require_root
    install -d -m 755 "$INSTALL_ROOT/releases"
    RUNTIME_CANDIDATE="$(mktemp -d "$INSTALL_ROOT/releases/.candidate-$VERSION.XXXXXX")"
    rmdir "$RUNTIME_CANDIDATE"
    if ! python3 "$REPOSITORY_ROOT/scripts/package-manager-runtime.py" stage \
        --source "$REPOSITORY_ROOT" --target "$RUNTIME_CANDIDATE"; then
        RUNTIME_CANDIDATE=""
        fail "manager runtime candidate is incomplete; active release was preserved"
    fi
    RUNTIME_DIGEST="$(python3 "$PACKAGE_VALIDATOR" digest --target "$RUNTIME_CANDIDATE")" ||
        fail "manager runtime candidate digest could not be verified; active release was preserved"
    RUNTIME_ID="build-$RUNTIME_DIGEST"
}

provision_manager_host() {
    getent group fortify-manager >/dev/null ||
        groupadd --system fortify-manager
    id fortify-manager >/dev/null 2>&1 ||
        useradd --system --gid fortify-manager --home-dir "$STATE_ROOT" \
            --shell /usr/sbin/nologin fortify-manager
    getent group fortify-health-probe >/dev/null ||
        groupadd --system fortify-health-probe
    id fortify-health-probe >/dev/null 2>&1 ||
        useradd --system --gid fortify-health-probe --groups fortify-manager \
            --home-dir /nonexistent --shell /usr/sbin/nologin fortify-health-probe
    install -d -m 700 -o fortify-manager -g fortify-manager "$STATE_ROOT"
    install -d -m 750 -o root -g fortify-manager "$CONFIG_ROOT"
}

publish_runtime_candidate() {
    local candidate="$1" digest="$2"
    RUNTIME_RELEASE="$INSTALL_ROOT/releases/build-$digest"
    if [ -e "$RUNTIME_RELEASE" ]; then
        [ -d "$RUNTIME_RELEASE" ] && [ ! -L "$RUNTIME_RELEASE" ] ||
            fail "immutable Manager release identity already exists with invalid content"
        existing_digest="$(python3 "$PACKAGE_VALIDATOR" digest --target "$RUNTIME_RELEASE" 2>/dev/null || true)"
        [ "$existing_digest" = "$digest" ] ||
            fail "immutable Manager release identity collision; existing release was preserved"
        rm -rf -- "$candidate"
        return
    fi
    mv "$candidate" "$RUNTIME_RELEASE" ||
        fail "validated Manager runtime could not be published"
}

atomic_current() {
    local target="$1" link="$INSTALL_ROOT/.current.$$.new"
    rm -f -- "$link"
    ln -s "$target" "$link"
    mv -Tf "$link" "$INSTALL_ROOT/current"
}

restore_current() {
    local prior="$1"
    if [ -n "$prior" ]; then
        atomic_current "$prior"
    else
        rm -f -- "$INSTALL_ROOT/current"
    fi
}

restore_service_state() {
    local service="$1" was_active="$2"
    if [ "$was_active" -eq 1 ]; then
        systemctl restart "$service"
    else
        systemctl stop "$service"
    fi
}

validate_release_start() {
    local release="$1" run_prestart="${2:-0}"
    python3 "$PACKAGE_VALIDATOR" validate --target "$release" >/dev/null ||
        fail "published Manager runtime failed validation"
    [ -x "$release/bin/fortify-manager-server" ] &&
        [ -x "$release/bin/fortify-manager-cli" ] &&
        [ -x "$release/bin/fortify-health-probe" ] ||
        fail "published Manager runtime has a missing or non-executable launcher"
    if [ "$run_prestart" -eq 1 ]; then
        "$release/bin/fortify-manager-server" check >/dev/null ||
            fail "published Manager runtime failed its pre-start check"
    fi
}

install_release_files() {
    local release="$1"
    ln -sfn "$INSTALL_ROOT/current/bin/fortify-manager-cli" "$CLI_PATH"
    if [ ! -e "$CONFIG_ROOT/manager.toml" ]; then
        install -m 640 -o root -g fortify-manager \
            "$release/config/manager.example.toml" \
            "$CONFIG_ROOT/manager.toml"
    fi
    install -m 644 "$release/packaging/systemd/fortify-manager.service" \
        "$UNIT_PATH"
    install -m 644 "$release/packaging/systemd/fortify-health-probe.service" \
        "$PROBE_UNIT_PATH"
    install -m 644 "$release/packaging/systemd/fortify-helm-release-evidence.service" \
        "$HELM_EVIDENCE_SERVICE_PATH"
    install -m 644 "$release/packaging/systemd/fortify-helm-release-evidence.timer" \
        "$HELM_EVIDENCE_TIMER_PATH"
    systemctl daemon-reload
}

record_activation_failure() {
    local evidence_root="$1" release_id="$2" stage="$3"
    install -d -m 700 -o fortify-manager -g fortify-manager "$evidence_root"
    install -m 600 -o fortify-manager -g fortify-manager /dev/null \
        "$evidence_root/activation-failure.txt"
    printf 'release=%s\nstage=%s\nrollback=attempted\nsecret_material=not-collected\n' \
        "$release_id" "$stage" >"$evidence_root/activation-failure.txt"
}

install_runtime() {
    require_root
    local prior="" evidence_root
    prepare_runtime_candidate
    provision_manager_host
    publish_runtime_candidate "$RUNTIME_CANDIDATE" "$RUNTIME_DIGEST"
    if [ ! -e "$CONFIG_ROOT/manager.toml" ]; then
        install -m 640 -o root -g fortify-manager \
            "$RUNTIME_RELEASE/config/manager.example.toml" "$CONFIG_ROOT/manager.toml"
    fi
    manager_config migrate
    validate_release_start "$RUNTIME_RELEASE" 0
    install_release_files "$RUNTIME_RELEASE"
    [ ! -e "$INSTALL_ROOT/current" ] || [ -L "$INSTALL_ROOT/current" ] ||
        fail "active Manager path is not a symlink; it was preserved"
    [ ! -L "$INSTALL_ROOT/current" ] || prior="$(readlink "$INSTALL_ROOT/current")"
    if ! atomic_current "$RUNTIME_RELEASE"; then
        evidence_root="$STATE_ROOT/backups/install-failure-$(date -u +%Y%m%dT%H%M%SZ)-$$"
        record_activation_failure "$evidence_root" "$RUNTIME_ID" "symlink-switch"
        fail "Manager release link could not be activated; prior release was preserved"
    fi
    if ! systemctl enable --now "$PROBE_SERVICE_NAME"; then
        restore_current "$prior"
        systemctl try-restart "$PROBE_SERVICE_NAME" >/dev/null 2>&1 || true
        evidence_root="$STATE_ROOT/backups/install-failure-$(date -u +%Y%m%dT%H%M%SZ)-$$"
        record_activation_failure "$evidence_root" "$RUNTIME_ID" "probe-start"
        fail "Manager activation failed; prior release was restored and sanitized evidence retained"
    fi
    systemctl enable --now fortify-helm-release-evidence.timer >/dev/null ||
        printf 'Warning: Helm release evidence timer is unavailable; inventory will fail closed.\n' >&2
    printf 'Installed Manager %s (%s); protected configuration and state were preserved.\n' \
        "$VERSION" "$RUNTIME_ID"
}

desired_rbac() {
    [ -r "$APISERVER_ARGS" ] &&
        grep -Eq '^--authorization-mode=([^#]*,)?RBAC(,|$)' "$APISERVER_ARGS"
}

apiserver_pid() {
    if [ -n "${FORTIFY_MANAGER_APISERVER_PID:-}" ]; then
        printf '%s\n' "$FORTIFY_MANAGER_APISERVER_PID"
        return
    fi
    pgrep -o -x kubelite 2>/dev/null || pgrep -o -f '(^|/)kube-apiserver( |$)' 2>/dev/null
}

rbac_runtime_state() {
    local pid
    desired_rbac || { printf 'desired-permissive\n'; return; }
    pid="$(apiserver_pid || true)"
    [ -n "$pid" ] && [ -r "/proc/$pid/stat" ] ||
        { printf 'effective-ambiguous\n'; return; }
    if python3 - "$APISERVER_ARGS" "/proc/$pid" 2>/dev/null <<'PY'
import os
import sys
try:
    changed = os.stat(sys.argv[1]).st_mtime_ns
    started = os.stat(sys.argv[2]).st_mtime_ns
except OSError:
    raise SystemExit(2)
raise SystemExit(0 if changed > started else 1)
PY
    then
        printf 'restart-required\n'
    else
        case "$?" in
            1) printf 'rbac-candidate\n' ;;
            *) printf 'effective-ambiguous\n' ;;
        esac
    fi
}

rbac_preflight() {
    require_root
    local state
    state="$(rbac_runtime_state)"
    case "$state" in
        desired-permissive)
            printf 'RBAC preflight: desired=permissive effective=permissive-or-ambiguous action=enable-rbac\n'
            return 2 ;;
        restart-required)
            printf 'RBAC preflight: desired=RBAC effective=previous-authorization action=restart-required\n'
            return 3 ;;
        rbac-candidate)
            printf 'RBAC preflight: desired=RBAC effective=verification-required action=verify-observer\n' ;;
        *)
            printf 'RBAC preflight: desired=RBAC effective=ambiguous action=investigate\n'
            return 4 ;;
    esac
}

publish_rbac_activation_evidence() {
    local runtime_state="$1" state="ambiguous" candidate
    case "$runtime_state" in
        restart-required) state="restart-required" ;;
        active) state="active" ;;
    esac
    install -d -m 700 -o fortify-manager -g fortify-manager "$CLUSTER_ACCESS_ROOT"
    candidate="$(mktemp "$CLUSTER_ACCESS_ROOT/.rbac-activation.XXXXXX")"
    printf '{"apiVersion":"fortifylab.io/v1alpha1","kind":"RbacActivationEvidence","state":"%s"}\n' \
        "$state" >"$candidate"
    chown root:fortify-manager "$candidate"
    chmod 640 "$candidate"
    mv -f "$candidate" "$CLUSTER_ACCESS_ROOT/rbac-activation.json"
}

observer_can() {
    microk8s kubectl auth can-i "$@" \
        --as=system:serviceaccount:fortify:fortify-manager-observer 2>/dev/null
}

verify_observer_authorization() {
    local result
    for check in \
        "get services -n fortify" \
        "list persistentvolumeclaims -n fortify" \
        "list deployments.apps -n fortify" \
        "list statefulsets.apps -n fortify" \
        "list ingresses.networking.k8s.io -n fortify" \
        "list nodes" \
        "list storageclasses.storage.k8s.io" \
        "get --non-resource-url=/version"; do
        # shellcheck disable=SC2086
        result="$(observer_can $check)" || return 1
        [ "$result" = "yes" ] || return 1
    done
    for check in \
        "get secrets -n fortify" \
        "get pods --subresource=log -n fortify" \
        "get services -n default"; do
        # shellcheck disable=SC2086
        result="$(observer_can $check)" || return 1
        [ "$result" = "no" ] || return 1
    done
}

install_cluster_access() {
    require_root
    local approve_enable=0 approve_restart=0 state token_candidate ca_candidate
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --approve-enable-rbac) approve_enable=1 ;;
            --approve-restart) approve_restart=1 ;;
            *) fail "unsupported install-cluster-access argument" ;;
        esac
        shift
    done
    install -d -m 700 -o fortify-manager -g fortify-manager "$CLUSTER_ACCESS_ROOT"
    if [ -f "$CLUSTER_ACCESS_ROOT/token" ]; then
        mv -f "$CLUSTER_ACCESS_ROOT/token" "$CLUSTER_ACCESS_ROOT/token.disconnected"
    fi
    state="$(rbac_runtime_state)"
    publish_rbac_activation_evidence "$state"
    if [ "$state" = desired-permissive ]; then
        [ "$approve_enable" -eq 1 ] ||
            fail "RBAC is not desired; review rbac-preflight and explicitly pass --approve-enable-rbac"
        microk8s enable rbac >/dev/null 2>&1 || true
        state="$(rbac_runtime_state)"
        publish_rbac_activation_evidence "$state"
        [ "$state" != desired-permissive ] ||
            fail "RBAC addon did not configure API-server arguments; Manager remains disconnected"
    fi
    if [ "$state" = restart-required ]; then
        [ "$approve_restart" -eq 1 ] ||
            fail "RBAC is configured but not effective; explicitly pass --approve-restart"
        if ! microk8s stop >/dev/null ||
            ! microk8s start >/dev/null; then
            fail "MicroK8s restart failed; Manager remains disconnected"
        fi
        state="$(rbac_runtime_state)"
        publish_rbac_activation_evidence "$state"
    fi
    [ "$state" = rbac-candidate ] ||
        fail "effective API-server authorization is ambiguous; Manager remains disconnected"
    microk8s kubectl apply -f \
        "$REPOSITORY_ROOT/packaging/microk8s/manager-observer-rbac.yaml" >/dev/null ||
        fail "observer access could not be installed"
    verify_observer_authorization ||
        fail "observer allow-list or mandatory denial verification failed; Manager remains disconnected"
    token_candidate="$(mktemp "$CLUSTER_ACCESS_ROOT/.token.XXXXXX")"
    ca_candidate="$(mktemp "$CLUSTER_ACCESS_ROOT/.ca.XXXXXX")"
    trap 'rm -f "$token_candidate" "$ca_candidate"' RETURN
    for _ in {1..15}; do
        microk8s kubectl -n fortify get secret \
            fortify-manager-observer-token \
            -o jsonpath='{.data.token}' 2>/dev/null |
            base64 -d >"$token_candidate" || true
        [ -s "$token_candidate" ] && break
        sleep 1
    done
    [ -s "$token_candidate" ] || fail "observer credential was not issued"
    microk8s kubectl -n fortify get secret \
        fortify-manager-observer-token \
        -o jsonpath='{.data.ca\.crt}' |
        base64 -d >"$ca_candidate" ||
        fail "cluster CA could not be protected"
    [ -s "$ca_candidate" ] || fail "cluster CA is empty"
    chown fortify-manager:fortify-manager "$token_candidate" "$ca_candidate"
    chmod 600 "$token_candidate" "$ca_candidate"
    mv -f "$token_candidate" "$CLUSTER_ACCESS_ROOT/token"
    mv -f "$ca_candidate" "$CLUSTER_ACCESS_ROOT/ca.crt"
    trap - RETURN
    rm -f "$CLUSTER_ACCESS_ROOT/token.disconnected"
    if ! manager_config migrate; then
        mv -f "$CLUSTER_ACCESS_ROOT/token" "$CLUSTER_ACCESS_ROOT/token.disconnected"
        fail "observer files are protected but configuration migration failed; Manager remains disconnected"
    fi
    publish_rbac_activation_evidence active
    printf 'Verified effective RBAC and activated namespace-scoped observer access; no application Secret was read.\n'
}

set_lifecycle_enabled() {
    local enabled="$1" source="$CONFIG_ROOT/manager.toml" candidate
    [ -f "$source" ] || fail "install the manager before changing lifecycle access"
    candidate="$(mktemp "$CONFIG_ROOT/.manager.toml.XXXXXX")"
    trap 'rm -f "$candidate"' RETURN
    python3 - "$source" "$candidate" "$enabled" <<'PY'
import os
import re
import sys

source, target, enabled = sys.argv[1:]
lines = open(source, encoding="utf-8").readlines()
in_lifecycle = False
replaced = False
for index, line in enumerate(lines):
    section = re.match(r"\s*\[([^]]+)\]\s*(?:#.*)?$", line)
    if section:
        in_lifecycle = section.group(1) == "lifecycle"
    elif in_lifecycle and re.match(r"\s*enabled\s*=", line):
        lines[index] = f"enabled = {enabled}\n"
        replaced = True
if not replaced:
    raise SystemExit("lifecycle.enabled is missing from manager configuration")
with open(target, "w", encoding="utf-8") as stream:
    stream.writelines(lines)
os.chmod(target, 0o640)
PY
    chown root:fortify-manager "$candidate"
    mv -f "$candidate" "$source"
    trap - RETURN
}

lifecycle_can() {
    local kubeconfig="$1"
    shift
    runuser -u fortify-manager -- env \
        KUBECONFIG="$kubeconfig" \
        PATH="$LIFECYCLE_CLIENT_ROOT:/usr/sbin:/usr/bin:/sbin:/bin" \
        microk8s kubectl auth can-i "$@" 2>/dev/null
}

install_lifecycle_clients() {
    local candidate
    [ -x "$KUBECTL_CLIENT" ] && [ -x "$HELM_CLIENT" ] ||
        fail "unprivileged Kubernetes lifecycle clients are unavailable; lifecycle remains disabled"
    install -d -m 755 "$LIFECYCLE_CLIENT_ROOT"
    chown root:fortify-manager "$LIFECYCLE_CLIENT_ROOT"
    candidate="$(mktemp "$LIFECYCLE_CLIENT_ROOT/.microk8s.XXXXXX")"
    trap 'rm -f "$candidate"' RETURN
    python3 - "$candidate" "$KUBECTL_CLIENT" "$HELM_CLIENT" <<'PY'
import os
import shlex
import sys

target, kubectl, helm = sys.argv[1:]
document = f"""#!/bin/sh
case "${{1:-}}" in
    kubectl)
        shift
        exec {shlex.quote(kubectl)} "$@"
        ;;
    helm3)
        shift
        exec {shlex.quote(helm)} "$@"
        ;;
    *)
        printf 'ERROR: unsupported lifecycle client command\n' >&2
        exit 64
        ;;
esac
"""
with open(target, "w", encoding="utf-8") as stream:
    stream.write(document)
os.chmod(target, 0o755)
PY
    chown root:fortify-manager "$candidate"
    mv -f "$candidate" "$LIFECYCLE_CLIENT_ROOT/microk8s"
    trap - RETURN
    runuser -u fortify-manager -- \
        "$LIFECYCLE_CLIENT_ROOT/microk8s" kubectl version --client >/dev/null ||
        fail "unprivileged Kubernetes lifecycle client verification failed; lifecycle remains disabled"
    runuser -u fortify-manager -- \
        "$LIFECYCLE_CLIENT_ROOT/microk8s" helm3 version --short >/dev/null ||
        fail "unprivileged Helm lifecycle client verification failed; lifecycle remains disabled"
}

verify_lifecycle_authorization() {
    local kubeconfig="$1" result check resource verb
    for resource in \
        configmaps services persistentvolumeclaims serviceaccounts \
        deployments.apps statefulsets.apps replicasets.apps jobs.batch \
        ingresses.networking.k8s.io; do
        for verb in get list watch create update patch delete; do
            result="$(lifecycle_can "$kubeconfig" "$verb" "$resource" -n fortify)" ||
                return 1
            [ "$result" = "yes" ] || return 1
        done
    done
    for resource in deployments.apps statefulsets.apps; do
        for verb in get update patch; do
            result="$(lifecycle_can "$kubeconfig" "$verb" "$resource" \
                --subresource=scale -n fortify)" || return 1
            [ "$result" = "yes" ] || return 1
        done
    done
    for check in \
        "get secrets -n fortify" \
        "list secrets -n fortify" \
        "get pods --subresource=log -n fortify" \
        "create pods --subresource=exec -n fortify" \
        "create pods --subresource=attach -n fortify" \
        "create pods --subresource=portforward -n fortify" \
        "get configmaps -n default" \
        "get namespaces" \
        "get persistentvolumes" \
        "get roles.rbac.authorization.k8s.io -n fortify" \
        "get clusterroles.rbac.authorization.k8s.io"; do
        # shellcheck disable=SC2086
        result="$(lifecycle_can "$kubeconfig" $check)" || return 1
        [ "$result" = "no" ] || return 1
    done
}

render_lifecycle_kubeconfig() {
    local token_file="$1" ca_file="$2" output="$3"
    python3 - "$token_file" "$ca_file" "$output" "$KUBERNETES_SERVER" <<'PY'
import base64
import os
import sys

token_path, ca_path, output, server = sys.argv[1:]
token = open(token_path, encoding="utf-8").read().strip()
ca = base64.b64encode(open(ca_path, "rb").read()).decode("ascii")
if not token or not ca or "\n" in token:
    raise SystemExit("dedicated lifecycle credential is invalid")
document = f"""apiVersion: v1
kind: Config
clusters:
- name: fortify-microk8s
  cluster:
    server: {server}
    certificate-authority-data: {ca}
users:
- name: fortify-manager-lifecycle
  user:
    token: {token}
contexts:
- name: fortify-lifecycle
  context:
    cluster: fortify-microk8s
    namespace: fortify
    user: fortify-manager-lifecycle
current-context: fortify-lifecycle
"""
with open(output, "w", encoding="utf-8") as stream:
    stream.write(document)
os.chmod(output, 0o600)
PY
}

activate_lifecycle() {
    require_root
    local token_candidate ca_candidate kubeconfig_candidate config_activated=0 ready=0
    install -d -m 700 "$CLUSTER_ACCESS_ROOT"
    chown fortify-manager:fortify-manager "$CLUSTER_ACCESS_ROOT"

    # A retry after any partial attempt always begins without mutation enabled.
    set_lifecycle_enabled false
    rm -f "$LIFECYCLE_KUBECONFIG"
    systemctl try-restart "$SERVICE_NAME" >/dev/null 2>&1 || true

    [ -d "$INSTALL_ROOT/current" ] ||
        fail "installed Manager runtime is missing; lifecycle remains disabled"
    python3 "$PACKAGE_VALIDATOR" validate --target "$INSTALL_ROOT/current" >/dev/null ||
        fail "installed Manager packaging verification failed; lifecycle remains disabled"
    "$INSTALL_ROOT/current/bin/fortify-manager-server" diagnose-cluster >/dev/null ||
        fail "protected observer verification failed; lifecycle remains disabled"
    install_lifecycle_clients

    health_socket="$(sed -n 's/^[[:space:]]*health_probe_socket[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$CONFIG_ROOT/manager.toml")"
    [ -n "$health_socket" ] && [ -S "$health_socket" ] &&
        runuser -u fortify-manager -- test -r "$health_socket" &&
        runuser -u fortify-manager -- test -w "$health_socket" ||
        fail "protected functional health probe is unavailable; lifecycle remains disabled"

    microk8s kubectl apply -f \
        "$REPOSITORY_ROOT/packaging/microk8s/manager-lifecycle-rbac.yaml" >/dev/null ||
        fail "lifecycle identity could not be installed; lifecycle remains disabled"

    token_candidate="$(mktemp "$CLUSTER_ACCESS_ROOT/.lifecycle-token.XXXXXX")"
    ca_candidate="$(mktemp "$CLUSTER_ACCESS_ROOT/.lifecycle-ca.XXXXXX")"
    kubeconfig_candidate="$(mktemp "$CLUSTER_ACCESS_ROOT/.lifecycle-kubeconfig.XXXXXX")"
    trap 'rm -f "$token_candidate" "$ca_candidate" "$kubeconfig_candidate"' RETURN
    for _ in {1..15}; do
        microk8s kubectl -n fortify get secret \
            fortify-manager-lifecycle-token \
            -o jsonpath='{.data.token}' 2>/dev/null |
            base64 -d >"$token_candidate" || true
        [ -s "$token_candidate" ] && break
        sleep 1
    done
    [ -s "$token_candidate" ] ||
        fail "dedicated lifecycle credential was not issued; lifecycle remains disabled"
    microk8s kubectl -n fortify get secret \
        fortify-manager-lifecycle-token \
        -o jsonpath='{.data.ca\.crt}' 2>/dev/null |
        base64 -d >"$ca_candidate" ||
        fail "lifecycle cluster CA could not be protected; lifecycle remains disabled"
    [ -s "$ca_candidate" ] ||
        fail "lifecycle cluster CA is empty; lifecycle remains disabled"
    render_lifecycle_kubeconfig "$token_candidate" "$ca_candidate" "$kubeconfig_candidate"
    chown fortify-manager:fortify-manager "$kubeconfig_candidate"
    chmod 600 "$kubeconfig_candidate"
    verify_lifecycle_authorization "$kubeconfig_candidate" ||
        fail "lifecycle allow-list or mandatory denial verification failed; lifecycle remains disabled"

    mv -f "$kubeconfig_candidate" "$LIFECYCLE_KUBECONFIG"
    rm -f "$token_candidate" "$ca_candidate"
    trap - RETURN
    set_lifecycle_enabled true
    config_activated=1
    if ! "$INSTALL_ROOT/current/bin/fortify-manager-server" check >/dev/null ||
        ! systemctl restart "$SERVICE_NAME"; then
        set_lifecycle_enabled false
        rm -f "$LIFECYCLE_KUBECONFIG"
        systemctl try-restart "$SERVICE_NAME" >/dev/null 2>&1 || true
        fail "Manager activation failed and lifecycle access was rolled back"
    fi
    for _ in {1..15}; do
        systemctl is-active --quiet "$SERVICE_NAME" && { ready=1; break; }
        sleep 1
    done
    if [ "$ready" -ne 1 ]; then
        [ "$config_activated" -eq 0 ] || set_lifecycle_enabled false
        rm -f "$LIFECYCLE_KUBECONFIG"
        systemctl try-restart "$SERVICE_NAME" >/dev/null 2>&1 || true
        fail "Manager did not become active and lifecycle access was rolled back"
    fi
    printf 'lifecycle-execution: available\n'
}

deactivate_lifecycle() {
    require_root
    set_lifecycle_enabled false
    rm -f "$LIFECYCLE_KUBECONFIG"
    rm -f "$LIFECYCLE_CLIENT_ROOT/microk8s"
    microk8s kubectl -n fortify delete rolebinding fortify-manager-lifecycle \
        secret fortify-manager-lifecycle-token --ignore-not-found >/dev/null ||
        fail "lifecycle configuration is disabled, but credential revocation needs operator attention"
    systemctl try-restart "$SERVICE_NAME" >/dev/null 2>&1 || true
    printf 'lifecycle-execution: disabled; lab workloads, data, Secrets, configuration, and operation history were preserved.\n'
}

bootstrap_account() {
    require_root
    local username="${1:-operator}" first second verifier temporary
    [[ "$username" =~ ^[a-zA-Z0-9_.-]{1,64}$ ]] ||
        fail "username contains unsupported characters"
    [ -t 0 ] || fail "account bootstrap requires an interactive terminal"
    read -r -s -p "Manager password: " first
    printf '\n'
    read -r -s -p "Confirm manager password: " second
    printf '\n'
    [ "${#first}" -ge 12 ] || fail "password must contain at least 12 characters"
    [ "$first" = "$second" ] || fail "passwords do not match"
    verifier="$(PYTHONPATH="$REPOSITORY_ROOT" python3 -c \
        'import sys; from manager.dashboard import password_verifier; print(password_verifier(sys.stdin.readline().rstrip("\n")))' \
        <<<"$first")"
    unset first second
    temporary="$(mktemp "$STATE_ROOT/.accounts.XXXXXX")"
    python3 - "$STATE_ROOT/accounts.json" "$temporary" "$username" "$verifier" <<'PY'
import json
import os
import sys
source, target, username, verifier = sys.argv[1:]
accounts = {}
try:
    with open(source, encoding="utf-8") as stream:
        accounts = json.load(stream)
except FileNotFoundError:
    pass
accounts[username] = verifier
with open(target, "w", encoding="utf-8") as stream:
    json.dump(accounts, stream, sort_keys=True)
    stream.write("\n")
os.chmod(target, 0o600)
PY
    chown fortify-manager:fortify-manager "$temporary"
    mv -f "$temporary" "$STATE_ROOT/accounts.json"
    printf 'Stored verifier for account %s; no plaintext password was persisted.\n' \
        "$username"
}

route_result() {
    printf 'Manager route: layer=%s state=%s detail=%s\n' "$1" "$2" "$3"
}

manager_route_expectations() {
    python3 - "$MANIFEST_PATH" <<'PY'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as stream:
    documents = list(yaml.safe_load_all(stream))
service = next(item for item in documents if item.get("kind") == "Service")
backend = next(item for item in documents if item.get("kind") in {"EndpointSlice", "Endpoints"})
ingress = next(item for item in documents if item.get("kind") == "Ingress")
rule = ingress["spec"]["rules"][0]
path = rule["http"]["paths"][0]["backend"]["service"]
if backend["kind"] == "EndpointSlice":
    address = backend["endpoints"][0]["addresses"][0]
    port = backend["ports"][0]["port"]
    discovery = "endpointslice"
else:
    address = backend["subsets"][0]["addresses"][0]["ip"]
    port = backend["subsets"][0]["ports"][0]["port"]
    discovery = "legacy"
values = (
    discovery, address, str(port), rule["host"],
    ingress["spec"].get("ingressClassName", ""),
    ingress["spec"]["tls"][0]["secretName"], path["name"],
    str(path["port"]["number"]), service["metadata"]["name"],
)
if any("\t" in value or "\n" in value for value in values):
    raise SystemExit(1)
print("\t".join(values))
PY
}

diagnose_manager_route() {
    local expected discovery address port host ingress_class tls_secret backend_name ingress_port service_name
    local failed=0 actual route_json resolved private_code external_code public_address
    expected="$(manager_route_expectations)" || {
        route_result configuration failed protected-manifest-invalid
        return 1
    }
    IFS=$'\t' read -r discovery address port host ingress_class tls_secret \
        backend_name ingress_port service_name <<<"$expected"
    public_address="$(configured_public_address "$address")" || {
        route_result public-dns failed protected-network-configuration-invalid
        route_result external-reachability blocked public-dns-unavailable
        return 1
    }

    if [ "$discovery" = endpointslice ]; then
        route_json="$(microk8s kubectl -n fortify get endpointslices.discovery.k8s.io \
            -l "kubernetes.io/service-name=$service_name" -o json 2>/dev/null)" || route_json=""
        actual="$(python3 -c 'import json,sys
try:
 d=json.load(sys.stdin); pairs={(a, str(p.get("port"))) for i in d.get("items",[]) for e in i.get("endpoints",[]) if e.get("conditions",{}).get("ready",True) for a in e.get("addresses",[]) for p in i.get("ports",[])}
 print("yes" if (sys.argv[1],sys.argv[2]) in pairs else "no")
except Exception: print("no")' "$address" "$port" <<<"$route_json")"
    else
        route_json="$(microk8s kubectl -n fortify get endpoints "$service_name" -o json 2>/dev/null)" || route_json=""
        actual="$(python3 -c 'import json,sys
try:
 d=json.load(sys.stdin); pairs={(a.get("ip"),str(p.get("port"))) for s in d.get("subsets",[]) for a in s.get("addresses",[]) for p in s.get("ports",[])}
 print("yes" if (sys.argv[1],sys.argv[2]) in pairs else "no")
except Exception: print("no")' "$address" "$port" <<<"$route_json")"
    fi
    if [ "$actual" = yes ]; then
        route_result private-backend healthy "${discovery}-address-and-port-match"
    else
        route_result private-backend failed "${discovery}-address-or-port-mismatch"
        failed=1
    fi

    route_json="$(microk8s kubectl -n fortify get ingress fortify-manager -o json 2>/dev/null)" || route_json=""
    actual="$(python3 -c 'import json,sys
try:
 d=json.load(sys.stdin); s=d.get("spec",{}); r=s.get("rules",[])[0]; b=r["http"]["paths"][0]["backend"]["service"]
 values=(r.get("host"),s.get("ingressClassName"),b.get("name"),str(b.get("port",{}).get("number")))
 print("yes" if values==tuple(sys.argv[1:]) else "no")
except Exception: print("no")' "$host" "$ingress_class" "$backend_name" "$ingress_port" <<<"$route_json")"
    if [ "$actual" = yes ]; then
        route_result ingress-routing healthy hostname-class-backend-and-port-match
    else
        route_result ingress-routing failed hostname-class-backend-or-port-mismatch
        failed=1
    fi

    actual="$(python3 -c 'import json,sys
try:
 s=json.load(sys.stdin).get("spec",{}); print("yes" if any(t.get("secretName")==sys.argv[1] and sys.argv[2] in t.get("hosts",[]) for t in s.get("tls",[])) else "no")
except Exception: print("no")' "$tls_secret" "$host" <<<"$route_json")"
    private_code="$(curl --silent --output /dev/null --max-time 5 --resolve "$host:443:$address" \
        --write-out '%{http_code}' "https://$host/ready" 2>/dev/null)" || private_code="000"
    if [ "$actual" = yes ] &&
        microk8s kubectl -n fortify get secret "$tls_secret" -o name >/dev/null 2>&1 &&
        [[ "$private_code" =~ ^(200|302|303|401|403)$ ]]; then
        route_result tls healthy secret-reference-and-private-handshake-valid
    else
        route_result tls failed secret-reference-secret-or-private-handshake-invalid
        failed=1
    fi

    resolved="$(getent ahostsv4 "$host" 2>/dev/null | awk '{print $1}' | sort -u)" || resolved=""
    if [ -n "$resolved" ] && [ "$resolved" = "$public_address" ]; then
        route_result public-dns healthy resolves-to-configured-public-address
        external_code="$(curl --silent --output /dev/null --max-time 5 --write-out '%{http_code}' \
            "https://$host/ready" 2>/dev/null)" || external_code="000"
        if [[ "$external_code" =~ ^(200|302|303|401|403)$ ]]; then
            route_result external-reachability healthy operator-route-reachable
        else
            route_result external-reachability unreachable operator-route-not-reachable
            failed=1
        fi
    else
        route_result public-dns failed does-not-resolve-exclusively-to-configured-public-address
        route_result external-reachability blocked dns-mismatch
        failed=1
    fi
    return "$failed"
}

diagnose() {
    require_root
    local failed=0
    "$INSTALL_ROOT/current/bin/fortify-manager-server" check ||
        failed=1
    "$INSTALL_ROOT/current/bin/fortify-manager-server" diagnose-cluster ||
        { printf 'ERROR: registry, API reachability, or observer permissions failed\n' >&2; failed=1; }
    systemctl is-active --quiet "$SERVICE_NAME" ||
        { printf 'ERROR: manager service is not active\n' >&2; failed=1; }
    probe_diagnose || failed=1
    backend_port="$(sed -n 's/^port = \([0-9]*\)$/\1/p' "$CONFIG_ROOT/manager.toml")"
    validate_port "$backend_port"
    readiness_url="http://127.0.0.1:$backend_port/ready"
    ready=0
    for _ in {1..15}; do
        if curl --fail --silent --max-time 2 "$readiness_url" >/dev/null; then
            ready=1
            break
        fi
        sleep 1
    done
    [ "$ready" -eq 1 ] ||
        { printf 'ERROR: backend readiness is unavailable\n' >&2; failed=1; }
    if [ -f "$MANIFEST_PATH" ]; then
        microk8s kubectl apply --dry-run=server -f "$MANIFEST_PATH" >/dev/null ||
            { printf 'ERROR: ingress manifest is rejected by MicroK8s\n' >&2; failed=1; }
        if microk8s kubectl diff -f "$MANIFEST_PATH" >/dev/null 2>&1; then
            :
        else
            case "$?" in
                1) printf 'ERROR: live manager route differs from the protected manifest; re-run configure\n' >&2 ;;
                *) printf 'ERROR: live manager route could not be compared; check MicroK8s access\n' >&2 ;;
            esac
            failed=1
        fi
        diagnose_manager_route || failed=1
    else
        printf 'ERROR: manager ingress has not been configured\n' >&2
        failed=1
    fi
    [ "$failed" -eq 0 ] || fail "one or more checks failed; no secret values were collected"
    printf 'Manager service, readiness, and layered route checks passed.\n'
}

probe_diagnose() {
    local health_socket
    systemctl is-active --quiet "$PROBE_SERVICE_NAME" ||
        { printf 'ERROR: functional probe service is not active\n' >&2; return 1; }
    health_socket="$(sed -n 's/^[[:space:]]*health_probe_socket[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$CONFIG_ROOT/manager.toml")"
    [ -S "$health_socket" ] &&
        [ "$(stat -c '%a' "$health_socket")" = 660 ] &&
        [ "$(stat -c '%U' "$health_socket")" = fortify-health-probe ] &&
        [ "$(stat -c '%G' "$health_socket")" = fortify-manager ] ||
        { printf 'ERROR: functional probe socket owner/group/mode is invalid\n' >&2; return 1; }
    runuser -u fortify-manager -- \
        "$INSTALL_ROOT/current/bin/fortify-health-probe" ping \
        --socket "$health_socket" >/dev/null ||
        { printf 'ERROR: functional probe protocol handshake failed\n' >&2; return 1; }
    printf 'Functional probe service and protected socket passed sanitized diagnostics.\n'
}

upgrade_runtime() {
    require_root
    local candidate stamp backup_root prior was_active=0 probe_was_active=0 rollback_failed=0
    prepare_runtime_candidate
    candidate="$RUNTIME_CANDIDATE"
    provision_manager_host
    [ -f "$CONFIG_ROOT/manager.toml" ] ||
        fail "Manager configuration is missing; use install for a clean installation"
    publish_runtime_candidate "$candidate" "$RUNTIME_DIGEST"
    [ -L "$INSTALL_ROOT/current" ] ||
        fail "active Manager release symlink is missing; upgrade did not stop the service"
    prior="$(readlink "$INSTALL_ROOT/current")"
    [ -d "$prior" ] ||
        fail "active Manager release target is invalid; upgrade did not stop the service"
    if [ "$(readlink -f "$prior")" = "$(readlink -f "$RUNTIME_RELEASE")" ]; then
        printf 'Manager %s is already installed; active release and services were unchanged.\n' \
            "$RUNTIME_ID"
        return
    fi

    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    backup_root="$STATE_ROOT/backups/$stamp-$$"
    install -d -m 700 -o fortify-manager -g fortify-manager "$backup_root"
    if [ -f "$STATE_ROOT/history.sqlite3" ]; then
        python3 - "$STATE_ROOT/history.sqlite3" "$backup_root/history.sqlite3" <<'PY'
import sqlite3
import sys
source = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
target = sqlite3.connect(sys.argv[2])
with target:
    source.backup(target)
source.close()
target.close()
PY
        chown fortify-manager:fortify-manager "$backup_root/history.sqlite3"
        chmod 600 "$backup_root/history.sqlite3"
    fi
    [ ! -f "$STATE_ROOT/accounts.json" ] ||
        install -m 600 -o fortify-manager -g fortify-manager \
            "$STATE_ROOT/accounts.json" "$backup_root/accounts.json"
    install -m 600 -o fortify-manager -g fortify-manager \
        "$CONFIG_ROOT/manager.toml" "$backup_root/manager.toml"
    manager_config migrate
    validate_release_start "$RUNTIME_RELEASE" 1
    install_release_files "$RUNTIME_RELEASE"

    systemctl is-active --quiet "$SERVICE_NAME" && was_active=1
    systemctl is-active --quiet "$PROBE_SERVICE_NAME" && probe_was_active=1
    systemctl stop "$SERVICE_NAME"
    if ! atomic_current "$RUNTIME_RELEASE"; then
        if ! restore_service_state "$SERVICE_NAME" "$was_active" >/dev/null 2>&1; then
            record_activation_failure "$backup_root" "$RUNTIME_ID" "symlink-switch-rollback"
            fail "Manager release link activation and prior service recovery failed; protected evidence was retained"
        fi
        record_activation_failure "$backup_root" "$RUNTIME_ID" "symlink-switch"
        fail "Manager release link could not be activated; prior release and service were restored"
    fi
    if ! systemctl restart "$PROBE_SERVICE_NAME" ||
        ! systemctl restart "$SERVICE_NAME"; then
        if ! restore_current "$prior"; then
            rollback_failed=1
        fi
        if ! restore_service_state "$PROBE_SERVICE_NAME" "$probe_was_active" >/dev/null 2>&1; then
            rollback_failed=1
        fi
        if ! restore_service_state "$SERVICE_NAME" "$was_active" >/dev/null 2>&1; then
            rollback_failed=1
        fi
        record_activation_failure "$backup_root" "$RUNTIME_ID" "service-restart"
        [ "$rollback_failed" -eq 0 ] ||
            fail "Manager activation and prior service recovery failed; protected evidence was retained"
        fail "Manager activation failed; prior release and service were restored and protected evidence retained"
    fi
    systemctl enable --now fortify-helm-release-evidence.timer >/dev/null ||
        printf 'Warning: Helm release evidence timer is unavailable; inventory will fail closed.\n' >&2
    printf 'Upgraded Manager atomically to %s; protected backup retained at %s.\n' \
        "$RUNTIME_ID" "$backup_root"
}

if [ "${FORTIFY_MANAGER_LIBRARY_ONLY:-0}" -eq 1 ]; then
    return 0
fi

command="${1:-}"
shift || true
case "$command" in
    install) install_runtime ;;
    config-inspect)
        require_root
        manager_config inspect
        ;;
    config-migrate)
        require_root
        manager_config migrate
        ;;
    config-rollback)
        require_root
        [ "$#" -eq 1 ] || fail "config-rollback requires one protected backup path"
        manager_config rollback "$1"
        ;;
    config-diagnose)
        require_root
        manager_config diagnose
        ;;
    rbac-preflight) rbac_preflight ;;
    install-cluster-access) install_cluster_access "$@" ;;
    activate-lifecycle) activate_lifecycle "$@" ;;
    deactivate-lifecycle) deactivate_lifecycle "$@" ;;
    refresh-release-evidence)
        require_root
        PYTHONPATH="$REPOSITORY_ROOT" python3 -m manager.helm_release_evidence \
            --output "$STATE_ROOT/helm-release-snapshot.json"
        printf 'Sanitized Helm release evidence refreshed.\n'
        ;;
    bootstrap-account) bootstrap_account "$@" ;;
    render-ingress) render_ingress "$@" ;;
    configure) configure_route "$@" ;;
    start|stop|restart|status)
        require_root
        systemctl "$command" "$SERVICE_NAME"
        ;;
    probe-status)
        require_root
        systemctl status "$PROBE_SERVICE_NAME"
        ;;
    probe-diagnose)
        require_root
        probe_diagnose
        ;;
    probe-restart)
        require_root
        systemctl restart "$PROBE_SERVICE_NAME"
        systemctl try-restart "$SERVICE_NAME"
        probe_diagnose
        ;;
    probe-disable)
        require_root
        systemctl disable --now "$PROBE_SERVICE_NAME"
        systemctl try-restart "$SERVICE_NAME" >/dev/null 2>&1 || true
        printf 'Functional health disabled; observation and lab data were preserved.\n'
        ;;
    upgrade) upgrade_runtime ;;
    diagnose) diagnose ;;
    uninstall)
        require_root
        systemctl disable --now "$SERVICE_NAME" 2>/dev/null || true
        systemctl disable --now "$PROBE_SERVICE_NAME" 2>/dev/null || true
        systemctl disable --now fortify-helm-release-evidence.timer 2>/dev/null || true
        microk8s kubectl -n fortify delete ingress fortify-manager \
            service fortify-manager-host endpoints fortify-manager-host \
            endpointslice fortify-manager-host \
            --ignore-not-found
        rm -f "$UNIT_PATH"
        rm -f "$PROBE_UNIT_PATH"
        rm -f "$HELM_EVIDENCE_SERVICE_PATH" "$HELM_EVIDENCE_TIMER_PATH"
        rm -f "$CLI_PATH"
        systemctl daemon-reload
        printf 'Manager service and ingress removed. Configuration and state preserved.\n'
        ;;
    delete-state)
        require_root
        read -r -p 'Type DELETE MANAGER STATE to continue: ' confirmation
        [ "$confirmation" = "DELETE MANAGER STATE" ] ||
            fail "state deletion cancelled"
        systemctl is-active --quiet "$SERVICE_NAME" &&
            fail "stop the manager before deleting state"
        find "$STATE_ROOT" -mindepth 1 -maxdepth 1 -delete
        printf 'Manager state deleted; this cannot be recovered without a backup.\n'
        ;;
    *) usage; [ -n "$command" ] && exit 1 ;;
esac
