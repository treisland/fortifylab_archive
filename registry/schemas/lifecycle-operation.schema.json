{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortifylab.local/registry/schemas/lifecycle-operation.schema.json",
  "title": "Lifecycle operation status",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "operation", "components", "requestedTargets", "actor", "state", "createdAt", "updatedAt", "currentStep", "completedSteps", "totalSteps", "retryOf", "error"],
  "properties": {
    "apiVersion": {"const": "fortifylab.io/v1alpha1"},
    "kind": {"const": "LifecycleOperation"},
    "id": {"type": "string", "format": "uuid"},
    "operation": {"enum": ["install", "configure", "start", "stop", "restart", "upgrade", "uninstall", "delete-data"]},
    "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "requestedTargets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "actor": {"type": "string", "minLength": 1, "maxLength": 128},
    "state": {"enum": ["queued", "running", "cancelling", "succeeded", "failed", "timed-out", "cancelled", "interrupted"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "currentStep": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "component", "operation", "attempt"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "component": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
            "operation": {"enum": ["install", "configure", "start", "stop", "upgrade", "uninstall", "delete-data"]},
            "attempt": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "completedSteps": {"type": "integer", "minimum": 0},
    "totalSteps": {"type": "integer", "minimum": 1},
    "retryOf": {"oneOf": [{"type": "null"}, {"type": "string", "format": "uuid"}]},
    "error": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 256}]},
    "workflow": {"enum": ["clean-install"]},
    "profileId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"}
  }
}
