{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortifylab.local/registry/schemas/health-report.schema.json",
  "title": "Dependency-aware environment health",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "generatedAt", "evidence", "state", "items"],
  "properties": {
    "apiVersion": {"const": "fortifylab.io/v1alpha1"},
    "kind": {"const": "EnvironmentHealth"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "validation"],
      "properties": {
        "source": {"enum": ["live-cluster", "unavailable"]},
        "validation": {"const": "runtime-observation"}
      }
    },
    "state": {"$ref": "#/$defs/state"},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "displayName", "state", "dependencies", "checkedAt", "evidence", "remediation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "displayName": {"type": "string", "minLength": 1, "maxLength": 128},
          "state": {"$ref": "#/$defs/state"},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "checkedAt": {"type": "string", "format": "date-time"},
          "blockedBy": {"type": "string"},
          "rootCause": {"type": "string"},
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "layer", "state", "required", "summary", "observedAt", "latencyMs"],
              "properties": {
                "id": {"type": "string"},
                "layer": {"enum": ["infrastructure", "storage", "workload", "network", "dependency", "application", "functional"]},
                "state": {"$ref": "#/$defs/state"},
                "required": {"type": "boolean"},
                "summary": {"type": "string", "minLength": 1, "maxLength": 256},
                "observedAt": {"type": "string", "format": "date-time"},
                "latencyMs": {"type": "integer", "minimum": 0}
              }
            }
          },
          "remediation": {
            "type": "object", "additionalProperties": false,
            "required": ["summary", "href", "safe"],
            "properties": {
              "summary": {"type": "string", "minLength": 1},
              "href": {"type": "string", "pattern": "^/docs/health-checks\\.md#[a-z0-9-]+$"},
              "safe": {"const": true}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "state": {"enum": ["healthy", "degraded", "unhealthy", "unknown", "blocked", "stale"]}
  }
}
