{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortifylab.local/registry/schemas/health-report.schema.json",
  "title": "Dependency-aware environment health",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "generatedAt", "evidence", "state", "summary", "items"],
  "properties": {
    "apiVersion": {"const": "fortifylab.io/v1alpha1"},
    "kind": {"const": "EnvironmentHealth"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "validation"],
      "properties": {
        "source": {"enum": ["live-cluster", "unavailable"]},
        "validation": {"const": "runtime-observation"}
      }
    },
    "state": {"$ref": "#/$defs/state"},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["components", "blocked", "workloadAbsent", "workloadNotReady", "applicationUnknown"],
      "properties": {
        "components": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "workloadAbsent": {"type": "integer", "minimum": 0},
        "workloadNotReady": {"type": "integer", "minimum": 0},
        "applicationUnknown": {"type": "integer", "minimum": 0}
      }
    },
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "displayName", "state", "dependencies", "checkedAt", "dimensions", "evidence", "remediation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "displayName": {"type": "string", "minLength": 1, "maxLength": 128},
          "state": {"$ref": "#/$defs/state"},
          "directState": {"$ref": "#/$defs/state"},
          "affectedDomains": {
            "type": "array", "uniqueItems": true,
            "items": {"enum": ["infrastructure", "workload", "persistence", "internalService", "application", "ingressRouting", "tls", "ingressTls", "externalReachability"]}
          },
          "downstreamImpact": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "domains": {
            "type": "object", "additionalProperties": false,
            "required": ["infrastructure", "workload", "persistence", "internalService", "application", "ingressRouting", "tls", "ingressTls", "externalReachability"],
            "properties": {
              "infrastructure": {"$ref": "#/$defs/domain"},
              "workload": {"$ref": "#/$defs/domain"},
              "persistence": {"$ref": "#/$defs/domain"},
              "internalService": {"$ref": "#/$defs/domain"},
              "application": {"$ref": "#/$defs/domain"},
              "ingressRouting": {"$ref": "#/$defs/domain"},
              "tls": {"$ref": "#/$defs/domain"},
              "ingressTls": {"$ref": "#/$defs/domain"},
              "externalReachability": {"$ref": "#/$defs/domain"}
            }
          },
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "checkedAt": {"type": "string", "format": "date-time"},
          "blockedBy": {"type": "string"},
          "rootCause": {"type": "string"},
          "rootCauses": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "dimensions": {
            "type": "object", "additionalProperties": false,
            "required": ["dependency", "workload", "application"],
            "properties": {
              "dependency": {
                "type": "object", "additionalProperties": false,
                "required": ["state", "blockedBy"],
                "properties": {
                  "state": {"enum": ["clear", "blocked"]},
                  "blockedBy": {"type": ["string", "null"]}
                }
              },
              "workload": {
                "type": "object", "additionalProperties": false,
                "required": ["state"],
                "properties": {"state": {"enum": ["ready", "absent", "not-ready", "unknown"]}}
              },
              "application": {
                "type": "object", "additionalProperties": false,
                "required": ["state"],
                "properties": {"state": {"enum": ["healthy", "unhealthy", "unknown"]}}
              }
            }
          },
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "layer", "state", "required", "summary", "observedAt", "latencyMs"],
              "properties": {
                "id": {"type": "string"},
                "layer": {"enum": ["infrastructure", "storage", "workload", "network", "dependency", "internal-service", "application", "functional", "ingress-routing", "tls", "external-reachability"]},
                "state": {"$ref": "#/$defs/state"},
                "required": {"type": "boolean"},
                "summary": {"type": "string", "minLength": 1, "maxLength": 256},
                "observedAt": {"type": "string", "format": "date-time"},
                "latencyMs": {"type": "integer", "minimum": 0},
                "derived": {"type": "boolean"},
                "blockedBy": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                "workload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["present", "desiredReplicas", "readyReplicas"],
                  "properties": {
                    "present": {"type": ["boolean", "null"]},
                    "desiredReplicas": {"type": ["integer", "null"], "minimum": 0},
                    "readyReplicas": {"type": ["integer", "null"], "minimum": 0}
                  }
                }
              }
            }
          },
          "remediation": {
            "type": "object", "additionalProperties": false,
            "required": ["summary", "href", "safe"],
            "properties": {
              "summary": {"type": "string", "minLength": 1},
              "href": {"type": "string", "pattern": "^/docs/health-checks\\.md#[a-z0-9-]+$"},
              "safe": {"const": true}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "state": {"enum": ["healthy", "starting", "degraded", "blocked", "misconfigured", "stopped", "unreachable", "unhealthy", "unknown", "stale"]},
    "domain": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "rootCause", "direct"],
      "properties": {
        "state": {"anyOf": [{"$ref": "#/$defs/state"}, {"const": "not-applicable"}]},
        "rootCause": {"type": ["string", "null"]},
        "direct": {"type": "boolean"}
      }
    }
  }
}
