{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortifylab.local/registry/schemas/preflight-report.schema.json",
  "title": "Read-only deployment preflight report",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "generatedAt", "ready", "readiness", "profile", "summary", "evidence", "items"],
  "properties": {
    "apiVersion": {"const": "fortifylab.io/v1alpha1"},
    "kind": {"const": "DeploymentPreflight"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "ready": {"type": "boolean"},
    "platformReadiness": {"$ref": "#/$defs/readiness"},
    "mutationAuthorization": {"$ref": "#/$defs/readiness"},
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation", "deployment", "start", "suspend"],
      "properties": {
        "observation": {"$ref": "#/$defs/readiness"},
        "deployment": {"$ref": "#/$defs/readiness"},
        "start": {"$ref": "#/$defs/readiness"},
        "suspend": {"$ref": "#/$defs/readiness"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "maturity", "vendorSupported"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "maturity": {"enum": ["experimental", "validated", "recommended", "deprecated", "unsupported"]},
        "vendorSupported": {"const": false}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker", "warning", "information"],
      "properties": {
        "blocker": {"type": "integer", "minimum": 0},
        "warning": {"type": "integer", "minimum": 0},
        "information": {"type": "integer", "minimum": 0}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "mode"],
      "properties": {
        "source": {"enum": ["runtime-adapter", "unavailable"]},
        "mode": {"const": "read-only"}
      }
    },
    "items": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "classification", "status", "summary", "latencyMs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "category": {"enum": ["capacity", "microk8s", "storage", "ingress", "dns-tls", "license", "registry", "configuration", "compatibility"]},
          "classification": {"enum": ["blocker", "warning", "information"]},
          "status": {"enum": ["pass", "warning", "fail"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 256},
          "latencyMs": {"type": "integer", "minimum": 0},
          "facts": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "integer", "boolean"]
            }
          },
          "remediation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "href", "safe"],
            "properties": {
              "summary": {"type": "string", "minLength": 1},
              "href": {"type": "string", "pattern": "^/docs/deployment-preflight\\.md#[a-z0-9-]+$"},
              "safe": {"const": true}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"classification": {"const": "blocker"}}},
            "then": {"required": ["remediation"]},
            "else": {"not": {"required": ["remediation"]}}
          }
        ]
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpuCores": {"type": "integer", "minimum": 0},
        "memoryGiB": {"type": "integer", "minimum": 0},
        "storageGiB": {"type": "integer", "minimum": 0},
        "remainingCpuCores": {"type": "integer", "minimum": 0},
        "remainingMemoryGiB": {"type": "integer", "minimum": 0},
        "remainingStorageGiB": {"type": "integer", "minimum": 0}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "osFamily": {"type": "string", "maxLength": 80},
        "osVersion": {"type": "string", "maxLength": 80},
        "kernel": {"type": "string", "maxLength": 80},
        "architecture": {"type": "string", "maxLength": 80},
        "microk8sVersion": {"type": "string", "maxLength": 80},
        "ec2": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "blockers"],
      "properties": {
        "ready": {"type": "boolean"},
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
        }
      }
    }
  }
}
