{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortifylab.local/schemas/component.schema.json",
  "title": "Fortify Lab Manager component",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "version",
    "dependencies",
    "workloads",
    "operations",
    "secrets",
    "persistence",
    "health",
    "diagnostics"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chart", "images"],
      "properties": {
        "chart": {"type": "string", "minLength": 1},
        "images": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "role", "scalable"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "kind": {"enum": ["StatefulSet", "Deployment"]},
          "name": {"type": "string", "minLength": 1},
          "role": {"enum": ["database", "application", "controller", "worker", "license-server"]},
          "scalable": {"type": "boolean"}
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "adapter",
          "disruptive",
          "destructive",
          "idempotent",
          "timeoutSeconds",
          "verify"
        ],
        "properties": {
          "id": {"enum": ["install", "start", "stop", "scale", "uninstall", "delete-data"]},
          "adapter": {"type": "string", "pattern": "^apps/.+\\.sh$"},
          "disruptive": {"type": "boolean"},
          "destructive": {"type": "boolean"},
          "idempotent": {"type": "boolean"},
          "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 7200},
          "verify": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
          }
        }
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kubernetesSecret", "classification", "required"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "kubernetesSecret": {"type": "string", "minLength": 1},
          "classification": {
            "enum": ["credential", "license", "token", "key", "certificate", "image-pull"]
          },
          "required": {"type": "boolean"}
        }
      }
    },
    "persistence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "purpose", "retainedOnUninstall"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "claim": {"type": "string", "minLength": 1},
          "purpose": {"enum": ["database", "application-data", "controller-data"]},
          "retainedOnUninstall": {"type": "boolean"}
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate", "checks"],
      "properties": {
        "aggregate": {"enum": ["all-required"]},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "target", "required", "timeoutSeconds"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "type": {
                "enum": [
                  "workload-ready",
                  "tcp",
                  "https",
                  "database-query",
                  "application-ready",
                  "dependency-connectivity",
                  "configuration",
                  "registration"
                ]
              },
              "target": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"},
              "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 600}
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "target", "sensitive"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "source": {"enum": ["workload-status", "events", "logs", "persistent-volume", "endpoint"]},
          "target": {"type": "string", "minLength": 1},
          "sensitive": {"type": "boolean"}
        }
      }
    }
  }
}
