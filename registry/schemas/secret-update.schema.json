{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortifylab.local/registry/schemas/secret-update.schema.json",
  "title": "Write-only secret update metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "kind", "id", "target", "actor", "sourceType", "state",
    "createdAt", "updatedAt", "impact", "restartedConsumers", "error", "recovery"
  ],
  "properties": {
    "apiVersion": {"const": "fortifylab.io/v1alpha1"},
    "kind": {"const": "SecretUpdate"},
    "id": {"type": "string", "format": "uuid"},
    "target": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"},
    "actor": {"type": "string", "minLength": 1, "maxLength": 128},
    "sourceType": {
      "enum": ["external-path", "upload", "kubernetes-secret", "generated"]
    },
    "state": {
      "enum": [
        "applying", "restarting", "verifying", "rolling-back", "succeeded",
        "failed", "rolled-back", "recovery-required", "interrupted"
      ]
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target", "classification", "sourceType", "consumers",
        "restartRequired", "expectedInterruption", "rollbackBoundary",
        "persistentDataBackupRequired", "healthVerificationRequired"
      ],
      "properties": {
        "target": {"type": "string"},
        "classification": {
          "enum": ["credential", "license", "token", "key", "certificate", "image-pull"]
        },
        "sourceType": {
          "enum": ["external-path", "upload", "kubernetes-secret", "generated"]
        },
        "consumers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
        },
        "restartRequired": {"type": "boolean"},
        "expectedInterruption": {"enum": ["none", "consumer restart"]},
        "rollbackBoundary": {"enum": ["adapter-revision", "restore-reference"]},
        "persistentDataBackupRequired": {"type": "boolean"},
        "healthVerificationRequired": {"type": "boolean"}
      }
    },
    "restartedConsumers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    },
    "error": {"type": ["string", "null"]},
    "recovery": {"type": ["string", "null"]}
  }
}
