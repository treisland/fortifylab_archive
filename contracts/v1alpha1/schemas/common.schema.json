{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortifylab.local/contracts/v1alpha1/common.schema.json",
  "title": "Fortify Lab Manager loop contract common types",
  "$defs": {
    "apiVersion": {"const": "fortifylab.io/v1alpha1"},
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "loop": {
      "enum": ["lifecycle", "health", "development", "improvement"]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"$ref": "#/$defs/identifier"},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observedAt", "collector", "correlationId"],
      "properties": {
        "source": {"$ref": "#/$defs/identifier"},
        "observedAt": {"$ref": "#/$defs/timestamp"},
        "collector": {"$ref": "#/$defs/identifier"},
        "correlationId": {"type": "string", "minLength": 1, "maxLength": 128},
        "parentId": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"$ref": "#/$defs/identifier"},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
