{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortifylab.local/contracts/v1alpha1/incident.schema.json",
  "title": "Incident",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "loop", "subject", "status", "severity", "summary", "eventIds", "rootCause", "openedAt", "provenance"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "Incident"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "loop": {"$ref": "common.schema.json#/$defs/loop"},
    "subject": {"$ref": "common.schema.json#/$defs/subject"},
    "status": {"enum": ["open", "mitigating", "resolved"]},
    "severity": {"enum": ["warning", "error", "critical"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 512},
    "eventIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "rootCause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "code", "summary"],
      "properties": {
        "eventId": {"type": "string", "minLength": 1, "maxLength": 128},
        "code": {"$ref": "common.schema.json#/$defs/identifier"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "openedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
    "resolvedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"}
  }
}
