{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortifylab.local/contracts/v1alpha1/health.schema.json",
  "title": "Health observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "loop", "subject", "status", "checks", "observedAt", "provenance"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "HealthObservation"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "loop": {"$ref": "common.schema.json#/$defs/loop"},
    "subject": {"$ref": "common.schema.json#/$defs/subject"},
    "status": {"enum": ["healthy", "degraded", "unhealthy", "unknown"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "required", "summary"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/identifier"},
          "status": {"enum": ["pass", "warn", "fail", "unknown"]},
          "required": {"type": "boolean"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "rootCauseCheckId": {"$ref": "common.schema.json#/$defs/identifier"},
    "observedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"}
  }
}
