{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortifylab.local/evaluations/verified-platform-lifecycle-v0.4/live-evidence.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "status", "reason"],
      "properties": {
        "apiVersion": {"const": "fortifylab.io/evaluations/v1alpha1"},
        "kind": {"const": "VerifiedPlatformLifecycleLiveEvidence"},
        "status": {"const": "not-run"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "status", "profileId", "profileVerification", "platform", "recordedAt", "expiresAt", "checks", "browserChecks", "commands", "limitations"],
      "properties": {
        "apiVersion": {"const": "fortifylab.io/evaluations/v1alpha1"},
        "kind": {"const": "VerifiedPlatformLifecycleLiveEvidence"},
        "status": {"const": "passed"},
        "profileId": {"type": "string", "minLength": 1, "maxLength": 96},
        "profileVerification": {"const": "verified"},
        "platform": {"const": "single-node MicroK8s"},
        "recordedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "checks": {"$ref": "#/$defs/checks"},
        "browserChecks": {"$ref": "#/$defs/browserChecks"},
        "commands": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
        "limitations": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
      }
    }
  ],
  "$defs": {
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleanInstall", "dependencyOrdering", "cancellation", "retry", "backupRestore", "upgrade", "rollbackBoundary", "serviceRestart", "secretSafety"],
      "properties": {
        "cleanInstall": {"const": "passed"},
        "dependencyOrdering": {"const": "passed"},
        "cancellation": {"const": "passed"},
        "retry": {"const": "passed"},
        "backupRestore": {"const": "passed"},
        "upgrade": {"const": "passed"},
        "rollbackBoundary": {"const": "passed"},
        "serviceRestart": {"const": "passed"},
        "secretSafety": {"const": "passed"}
      }
    },
    "browserChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actualClusterState", "primaryRootCause", "blockedConsumers", "actionableRemediation"],
      "properties": {
        "actualClusterState": {"const": "passed"},
        "primaryRootCause": {"const": "passed"},
        "blockedConsumers": {"const": "passed"},
        "actionableRemediation": {"const": "passed"}
      }
    }
  }
}
