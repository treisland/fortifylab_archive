{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortifylab.local/evaluations/v1alpha1/schema.json",
  "title": "Fortify Lab Manager loop evaluation corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "corpusVersion", "cases"],
  "properties": {
    "apiVersion": {"const": "fortifylab.io/evaluations/v1alpha1"},
    "kind": {"const": "LoopEvaluationCorpus"},
    "corpusVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "input", "expected"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "description": {"type": "string", "minLength": 1, "maxLength": 512},
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["loop", "subject", "signals"],
          "properties": {
            "loop": {"enum": ["lifecycle", "health", "development", "improvement"]},
            "subject": {"$ref": "#/$defs/identifier"},
            "signals": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "value"],
                "properties": {
                  "code": {"$ref": "#/$defs/identifier"},
                  "value": {"type": ["string", "integer", "number", "boolean", "null"]}
                }
              }
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "safeAction", "redaction"],
          "properties": {
            "classification": {
              "enum": [
                "healthy",
                "dependency-unavailable",
                "authentication-failed",
                "application-not-ready",
                "initialization-in-progress",
                "unsafe-path",
                "tls-failed",
                "configuration-missing",
                "registration-failed",
                "retry-exhausted",
                "duplicate-observation",
                "sensitive-output",
                "destructive-approval-required"
              ]
            },
            "safeAction": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "automatic", "destructive", "requiresApproval"],
              "properties": {
                "code": {"$ref": "#/$defs/identifier"},
                "automatic": {"type": "boolean"},
                "destructive": {"type": "boolean"},
                "requiresApproval": {"type": "boolean"}
              }
            },
            "redaction": {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "categories", "forbiddenSubstrings"],
              "properties": {
                "required": {"type": "boolean"},
                "categories": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "credential",
                      "token",
                      "license",
                      "private-key",
                      "certificate",
                      "environment",
                      "path"
                    ]
                  }
                },
                "forbiddenSubstrings": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1, "maxLength": 128}
                }
              }
            }
          }
        }
      }
    }
  }
}
