{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortifylab.local/profiles/schemas/release-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "apiVersion", "kind", "profileId", "recordedAt", "evidenceLevel", "checks", "conclusion"],
  "properties": {
    "$schema": {"const": "../schemas/release-evidence.schema.json"},
    "apiVersion": {"const": "fortifylab.io/v1alpha1"},
    "kind": {"const": "PlatformProfileEvidence"},
    "profileId": {"type": "string", "minLength": 1},
    "recordedAt": {"type": "string", "format": "date-time"},
    "evidenceLevel": {"enum": ["static", "licensed-live"]},
    "checks": {"type": "object", "additionalProperties": {"enum": ["passed", "failed", "not-run"]}},
    "conclusion": {"enum": ["experimental", "validated"]}
  }
}
