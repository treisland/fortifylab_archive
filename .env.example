#:W
# FORTIFY HELM ENVIRONMEMNT VARIABLES
# -----------------------------------
#
# Single location for that makes it easier to configure
# the deployment of tools

# Requires environment variables "FORTIFY_HOME_K8S" set to the full path
# for the parent folder where this script resides

#example 
# <file: ~/bash_profile>
#
# export FORTIFY_HOME_K8S=$HOME/fortifyk8s
#
#========================================================

# set the namespace for the resource in your cluster
export NAMESPACE="fortify"

#--------------------------
# SECTION: CREDENTIALS
#--------------------------
# Defined first so other sections (CERTIFICATES, etc.) can reference $DEFAULT_PASS

export DEFAULT_PASS="changeme"

export DEFAULT_ALIAS="fortify"

export SCDAST_SSC_USER="scdast"

export SCDAST_SSC_PASS="change-me-in-env"

export SCDAST_DB_OWNER_USER="postgres"

#change this if you don't want to use the default password
export SCDAST_DB_OWNER_PASS=$DEFAULT_PASS

export SCDAST_DB_STANDARD_USER="dast_user"

#change this if you don't want to use the default password
export SCDAST_DB_STANDARD_PASS=$DEFAULT_PASS

export LIM_POOL_NAME="Default"

#change this if you don't want to use the default password
export LIM_POOL_PASS=$DEFAULT_PASS

#--------------------------
# SECTION: SECRETS
#--------------------------
export FORTIFY_SECRETS=$FORTIFY_HOME_K8S/secrets
export FORTIFY_SECRETS_INPUT=$FORTIFY_SECRETS/input
export FORTIFY_SECRETS_TEMPLATES=$FORTIFY_SECRETS/templates
export FORTIFY_SECRETS_GENERATED=$FORTIFY_SECRETS/generated

# May point outside the repository. The historical repository-local location
# remains the default. Never commit the license or include it in support data.
export FORTIFY_LICENSE_FILE="${FORTIFY_LICENSE_FILE:-$FORTIFY_SECRETS_INPUT/fortify.license}"

#--------------------------
# SECTION: DOMAINS
#--------------------------

export FORTIFY_RULES_DOMAIN="update.fortify.com"

# set the top-level domain name
export DOMAIN="fortifydemo.com"

export SSC="ssc.$DOMAIN"
export LIM="lim.$DOMAIN"
export SCDAST="dast.$DOMAIN"
export SCSAST="sast.$DOMAIN"

#--------------------------
# SECTION: URLS
#--------------------------

# NOTE: #using ingress addresses is recommended for full access
# internal service names can be used however there are UI issues
# when that internal address is used by an client outside of the cluster
# such as setting up SCDAST url in SSC

export SSC_URL="https://$SSC"
export LIM_URL="https://$LIM"
export LIM_API_URL="https://$LIM/LIM.API"
export SCDAST_URL="https://$SCDAST"
export SCSAST_URL="https://$SCSAST"
export SCSAST_CTRL_URL="https://$SCSAST/scancentral-ctrl/"

#--------------------------
# SECTION: CERTIFICATES
#--------------------------

#uncomment out the line below and provide a location where certicates wll be stored
#default location for certicates will be $HOME/.local/share/mkcert
export FORTIFY_CERTS=$FORTIFY_HOME_K8S/certs

export FORTIFY_RULES_CERT=$FORTIFY_CERTS/$FORTIFY_RULES_DOMAIN.crt

#names for the certs
export ROOTCA_CERT=$FORTIFY_CERTS/rootCA.pem

export ROOTCA_KEY=$FORTIFY_CERTS/rootCA-key.pem

export ROOTCA_PFX=$FORTIFY_CERTS/rootCA.pfx

export SERVER_CERT=$FORTIFY_CERTS/tls.crt

export SERVER_KEY=$FORTIFY_CERTS/tls.key

export KEYSTORE=$FORTIFY_CERTS/keystore.p12

export LIM_SIGNING_CERT_PEM=$ROOTCA_CERT

export LIM_SIGNING_CERT_PFX=$ROOTCA_PFX

export LIM_SIGNING_KEY_PEM=$ROOTCA_KEY

export LIM_SERVER_CERT_PEM=$SERVER_CERT

export LIM_SERVER_KEY_PEM=$SERVER_KEY

export LIM_SIGNING_CERT_PWD="$DEFAULT_PASS"

#--------------------------
# SECTION: KEYSTORES
#--------------------------

export JVM_KEYSTORE=$FORTIFY_CERTS/keystore.jks

export TRUSTSTORE=$FORTIFY_CERTS/truststore

#--------------------------
# SECTION: IMAGE VERSIONS
#--------------------------
# Intentional fresh-lab evaluation bundle. These pins avoid moving tags, but
# have not yet completed the clean-install and upgrade evidence required for
# a supported platform profile. Keep the bundle together; changing one value
# creates a custom, unverified combination. See docs/platform-compatibility.md.

export FORTIFY_SSC_CHART_VERSION="24.4.2-1"
export FORTIFY_SSC_IMAGE_TAG="24.4.2.0009"

export FORTIFY_SCSAST_CHART_VERSION="24.4.0-2"
export FORTIFY_SCSAST_CTRL_IMAGE_TAG="24.4.0.0060"
export FORTIFY_SCSAST_WORKER_IMAGE_TAG="24.4.1"

export FORTIFY_SCDAST_CHART_VERSION="24.4.0-2"

export FORTIFY_LIM_CHART_VERSION="24.4.0-3"

export FORTIFY_MYSQL_CHART_VERSION="9.19.0"
export FORTIFY_POSTGRES_CHART_VERSION="18.6.2"
export FORTIFY_POSTGRES_IMAGE_TAG="17.6.0-debian-12-r4"
export FORTIFY_MYSQL_IMAGE_TAG="8.0.36-debian-11-r2"
